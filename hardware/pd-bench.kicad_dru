(version 1)

# GCT USB4105 drawing B4 (18 Dec 2023), recommended PCB pattern, sheet 1.
# Original land pattern retained: 0.65 mm locating holes, 0.60 x 1.15 mm
# ground lands. Nominal minimum measured in KiCad is 0.1944 mm.
# Applies only to pad/hole pairs INSIDE J1, not external routing or pours.
# Fabricator acceptance of this spacing/tolerance is still a release gate.
(rule "J1 manufacturer land pattern - internal hole spacing"
  (condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1')")
  (constraint hole_clearance (min 0.19mm)))

# USB contact pitch requires the ordinary 0.20 mm fanout clearance.
(rule "J1 power contact fanout"
  (condition "A.memberOfFootprint('J1') || B.memberOfFootprint('J1')")
  (constraint clearance (min 0.20mm)))

# USB ground contacts carry load return current; use solid reflow connections.
# The plated shell stakes retain normal thermal relief connections.
(rule "J1 ground contact solid connection"
  (condition "A.memberOfFootprint('J1') && A.Type == 'Pad' && A.Pad_Type == 'SMD' && A.NetName == '/GND'")
  (constraint zone_connection solid))
